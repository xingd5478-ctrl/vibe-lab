{
  "name": "vibe-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Sensor & control visual lab: IMU data lab, control playground, landing page",
  "scripts": {
    "test": "node --test tests/allan.test.js tests/kf.test.js tests/fit.test.js tests/worker.test.js tests/data.test.js tests/workers.test.js tests/simulink.test.js tests/guide.test.js tests/chart.test.js tests/matlab.test.js tests/contrast.test.js",
    "smoke": "node scripts/smoke.mjs",
    "sync:chart": "node scripts/sync_chart.mjs",
    "check:chart": "node scripts/sync_chart.mjs --check",
    "budget": "node scripts/budget.mjs",
    "perf": "node scripts/perf.mjs",
    "matlab:data": "node scripts/build_matlab_data.mjs",
    "matlab:table": "node scripts/build_matlab_table.mjs",
    "check:matlab": "node scripts/check_matlab_data.mjs && node scripts/build_matlab_table.mjs --check",
    "visual": "pwsh -NoProfile -File scripts/visual.ps1",
    "visual:update": "pwsh -NoProfile -File scripts/visual.ps1 -Update",
    "visual:dark": "node scripts/dark_shots.mjs",
    "visual:dark:update": "node scripts/dark_shots.mjs --update",
    "e2e": "node scripts/e2e.mjs",
    "bigtest": "node scripts/bigtest.mjs",
    "visual:mobile": "node scripts/mobile_shots.mjs",
    "visual:mobile:update": "node scripts/mobile_shots.mjs --update",
    "domain": "node scripts/set_domain.mjs",
    "sync:feedback": "node scripts/sync_feedback.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0"
  }
}
